POSTGRES_USER=kinesiapp
POSTGRES_PASSWORD=kinesiapp
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=kinesiapp

# Flutter Web local. En producción define el origen exacto de la aplicación.
# Solo desarrollo local: restringe los orígenes a dominios confiables en producción.
CORS_ALLOWED_ORIGINS=["*"]
CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

PGADMIN_DEFAULT_EMAIL=admin@kinesiapp.com
PGADMIN_DEFAULT_PASSWORD=admin

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
