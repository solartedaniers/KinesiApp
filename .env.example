POSTGRES_USER=kinesiapp
POSTGRES_PASSWORD=kinesiapp
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=kinesiapp

# Local: el regex ya admite el frontend Next.js en http://localhost:3000.
CORS_ALLOWED_ORIGINS=[]
CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

PGADMIN_DEFAULT_EMAIL=admin@kinesiapp.com
PGADMIN_DEFAULT_PASSWORD=admin

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=KinesiApp
SMTP_USE_TLS=true
# Alternativa si STARTTLS falla en Docker: SMTP_PORT=465 y SMTP_USE_SSL=true
SMTP_USE_SSL=false
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Proceso interno que reporta resultados a POST /jump-analyses/{id}/results (header X-Service-Api-Key).
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))". Vacía = endpoint cerrado.
JUMP_ANALYSIS_SERVICE_API_KEY=
# Versión vigente del texto de consentimiento de video. El cliente web la lee de GET /public/video-consent
VIDEO_CONSENT_VERSION=1

# ---------------------------------------------------------------------------
# Producción (Hetzner + Neon + Vercel). Reemplaza los valores de arriba en el .env del
# servidor; ver docs/design/web-frontend-architecture.md §2 y §12.
# ---------------------------------------------------------------------------
# Neon: copia los datos del connection string del endpoint DIRECTO (sin "-pooler" en el host),
# el que usa Alembic para migrar. Formato: postgresql://<user>:<password>@<host>/<db>?sslmode=require
# POSTGRES_HOST=ep-xxxx-xxxxxxxx.eu-central-1.aws.neon.tech
# POSTGRES_PORT=5432
# POSTGRES_USER=<usuario de Neon>
# POSTGRES_PASSWORD=<contraseña de Neon>
# POSTGRES_DB=neondb
#
# TLS obligatorio. libpq (psycopg2) lee PGSSLMODE del ENTORNO DEL PROCESO, no de este archivo
# (pydantic-settings no lo exporta): en Docker va en el env_file (.env.docker) del servicio api;
# para correr Alembic desde tu PC contra Neon, defínela en la terminal:
#   PowerShell: $env:PGSSLMODE="require"     bash: export PGSSLMODE=require
# PGSSLMODE=require
#
# CORS: dominio de producción de Vercel (y el propio si se agrega uno). Sin barra final.
# CORS_ALLOWED_ORIGINS=["https://kinesiapp.vercel.app"]
# Deploys de preview de Vercel: sólo los del proyecto/equipo, nunca .*\.vercel\.app abierto.
# CORS_ALLOW_ORIGIN_REGEX=^https://kinesiapp-[a-z0-9-]+-<team-slug>\.vercel\.app$
