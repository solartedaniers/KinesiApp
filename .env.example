# Neon (ya no hay Postgres en Docker). Local: datos del connection string DIRECTO (host SIN
# "-pooler"), el mismo que usa Alembic. Formato: postgresql://<user>:<password>@<host>/<db>?sslmode=require
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=ep-xxxx-xxxxxxxx.eu-central-1.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_DB=neondb
# libpq (psycopg2) lee PGSSLMODE del ENTORNO DEL PROCESO, no de este archivo (pydantic-settings no
# lo exporta). docker-compose sí la pasa al servicio api; para uvicorn/alembic desde tu PC:
#   PowerShell: $env:PGSSLMODE="require"     bash: export PGSSLMODE=require
PGSSLMODE=require

# Local: el regex ya admite el frontend Next.js en http://localhost:3000.
CORS_ALLOWED_ORIGINS=[]
CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Correo transaccional con Resend (https://resend.com/api-keys); NUNCA se versiona. Vacía = el
# registro y la recuperación de contraseña responden 503 email_delivery_failed.
RESEND_API_KEY=
# onboarding@resend.dev sólo entrega al correo del dueño de la cuenta de Resend: para usuarios
# reales, verifica un dominio en Resend y usa una dirección de él. Admite "KinesiApp <no-reply@tu-dominio>"
RESEND_FROM_EMAIL=onboarding@resend.dev
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Proceso interno que reporta resultados a POST /jump-analyses/{id}/results (header X-Service-Api-Key).
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))". Vacía = endpoint cerrado.
JUMP_ANALYSIS_SERVICE_API_KEY=
# Versión vigente del texto de consentimiento de video. El cliente web la lee de GET /public/video-consent
VIDEO_CONSENT_VERSION=1

# Chat con Gemini. La key se crea en https://aistudio.google.com ("Get API key"); NUNCA se versiona.
# Vacía = el chat responde 503 assistant_unavailable. Límites: ver backend/app/core/config.py
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Almacenamiento de objetos S3 de Neon (consola de Neon → Storage). Los videos se suben al bucket
# de videos y en la base se guarda su URL pública. Vacías = subir un video responde 503 storage_unavailable
AWS_ENDPOINT_URL_S3=https://br-xxxx-xxxxxxxx.storage.c-6.eu-central-1.aws.neon.tech
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_VIDEOS_BUCKET=videos
# Preparado para las fotos de perfil; todavía no lo usa ningún flujo
S3_IMAGES_BUCKET=images

# ---------------------------------------------------------------------------
# Producción (Cloud Run + Neon + Vercel). No hay .env en el servidor: cada valor es una variable
# del servicio de Cloud Run (secretos en Secret Manager). Ver docs/design/web-frontend-architecture.md
# §2 y §12 y la lista completa en docs/status/STATUS_2026-10-03-deploy.md.
# ---------------------------------------------------------------------------
# Neon en Cloud Run: el host CON "-pooler" (cada instancia abre su propio pool; el directo se
# quedaría sin conexiones al escalar). Alembic sigue usando el directo, desde tu .env local.
# POSTGRES_HOST=ep-xxxx-xxxxxxxx-pooler.eu-central-1.aws.neon.tech
# PGSSLMODE=require   (variable del servicio: en Cloud Run sí llega al entorno del proceso)
#
# CORS: dominio de producción de Vercel (y el propio si se agrega uno). Sin barra final.
# CORS_ALLOWED_ORIGINS=["https://kinesiapp.vercel.app"]
# Deploys de preview de Vercel: sólo los del proyecto/equipo, nunca .*\.vercel\.app abierto.
# CORS_ALLOW_ORIGIN_REGEX=^https://kinesiapp-[a-z0-9-]+-<team-slug>\.vercel\.app$
